# Kairos API credentials.
#
# kairos.trade -> profile picture (top right) -> Settings -> API Tokens -> Create API
# token. Choose the "Trading" access level if the token will place orders, "Read-only"
# if it won't. The reveal dialog has a "Copy all as .env" button that produces exactly
# these three lines — paste them here.
#
# All three are required on every authenticated request; a partial set is a 401.
# They are shown once and never again. Copy this file to .env, which is gitignored.
# Never paste these values into a chat window, a prompt, or a commit.

KAIROS_CLIENT_ID=
KAIROS_API_KEY=
KAIROS_CLIENT_SECRET=

# Optional overrides — leave unset for production.
# KAIROS_EXECUTION_URL=https://execution.kairos.trade
# KAIROS_MARKET_DATA_URL=https://md.kairos.trade
